{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/hooks/context_state_hook.py\" record",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/hooks/context_state_hook.py\" stop",
        "timeout": 10,
        "loop_limit": 1
      }
    ]
  }
}
